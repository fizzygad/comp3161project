# === Flask Settings ===
FLASK_APP=DBMSProjectAPI.py  # Case-sensitive filename
FLASK_ENV=production
PORT=5000                    # Default Flask port
SECRET_KEY=your-flask-secret-key-here  # For session encryption
JWT_SECRET=your-jwt-secret-here        # For token generation

# === MySQL Database ===
# Local Development (example values)
MYSQLHOST=localhost
MYSQLUSER=db_user
MYSQLPASSWORD=db_password
MYSQLDATABASE=comp3161finalproj        # Matches DB name
MYSQLPORT=port-here

# === Railway Deployment ===
# These will be auto-filled by Railway:
# MYSQLHOST=host-name-here
# MYSQLUSER=user-here
# MYSQLPASSWORD=auto-generated
# MYSQLDATABASE=database-here
# MYSQLPORT=port-here